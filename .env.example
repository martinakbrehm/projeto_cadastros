# Copie este arquivo para .env e preencha os valores.

# Chave secreta das sessoes do Flask (gere uma aleatoria e mantenha em segredo)
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-bem-grande

# Arquivo JSON da conta de servico do Google (baixado no Google Cloud)
GOOGLE_CREDENTIALS_FILE=credentials_google.json

# IDs das planilhas (a parte entre /d/ e /edit na URL do Google Sheets)
SHEET_CREDENCIAIS_ID=cole-aqui-o-id-da-planilha-de-configuracao
SHEET_REGISTROS_ID=cole-aqui-o-id-da-planilha-de-registros

# Nomes das abas
ABA_SENHA=senha
ABA_EMAILS=emails
ABA_MAPA=mapa_projeto
ABA_PORTAL=cadastros
ABA_FILA=fila

# Credenciais dos portais (ficam SO aqui, nunca na planilha nem no Git)
LIGO_USER=usuario-do-crm-ligo
LIGO_PASSWORD=senha-do-crm-ligo
AYTY_USER=usuario-do-ayty
AYTY_PASSWORD=senha-do-ayty

# Notificacao por e-mail (Gmail: use uma "senha de app", nao a senha normal da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-de-16-digitos
EMAIL_FROM=seu-email@gmail.com

# Opcionais (tem padrao no codigo)
# URL_LIGO=https://crm.digitalcontact.cloud/authentication
# URL_AYTY=https://app33.digitalcontact.cloud/Ayty/AppTECHBRASILCCPAAS/AytyPortalExFrontEndWeb/Views/Default.aspx
# AYTY_SUPERVISOR_DISTRATO=teste code7

# --- Ambiente / execucao ---
# Debug do Flask: deixe VAZIO em producao (nunca 1 num site publico).
FLASK_DEBUG=
# Chrome oculto: 1 na nuvem (container sem tela). Local deixe vazio p/ ver a janela.
HEADLESS=
# --- Deploy na nuvem (Railway) ---
# Em vez do arquivo credentials_google.json, cole o JSON inteiro numa variavel:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
# Chromium do container (o Dockerfile do robo ja define estes):
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
